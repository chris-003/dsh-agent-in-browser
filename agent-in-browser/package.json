{
  "name": "@chris/agent-in-browser",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that exposes a WebSocket server for a Chrome extension, giving the agent browser control (read page, screenshot, interact, tabs) via new tool calls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./protocol": {
      "default": "./lib/protocol/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "ws": "^8.21.3"
  }
}
